// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider     = "prisma-client"
    output       = "../src/prisma/generated"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    USER
    ADMIN
}

model User {
    id       String  @id @default(uuid())
    email    String  @unique
    password String
    username String? @unique
    role     Role    @default(USER)

    whiteGames Game[] @relation("WhitePlayer")
    blackGames Game[] @relation("BlackPlayer")
    wonGames   Game[] @relation("Winner") @ignore // Never used, just to satisfy prisma's relation requirements

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    games     Game[]

    @@map("users")
}

enum GameStatus {
    WAITING
    ONGOING
    FINISHED
    ABORTED
}

enum GameMode {
    ONLINE
    AI
}

model Game {
    id String @id @default(uuid())

    status GameStatus @default(WAITING)
    mode   GameMode   @default(ONLINE)

    whiteId String
    blackId String?

    white User  @relation("WhitePlayer", fields: [whiteId], references: [id])
    black User? @relation("BlackPlayer", fields: [blackId], references: [id])

    winnerId String?
    winner   User?   @relation("Winner", fields: [winnerId], references: [id])

    currentFen String?

    pgn String?

    timeControl String @default("unlimited")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    user      User?    @relation(fields: [userId], references: [id])
    userId    String?

    @@map("games")
}
