{
	"name": "API DEV", // name of the dev container
	"dockerComposeFile": "../../docker/docker-compose.dev.yml", // path to docker-compose file
	"service": "api", // service name in docker-compose.yml
	"workspaceFolder": "/app", // workdir in the container
	"containerEnv": {
		"PORT": "3001" // update default port to prevent conflict with 3000 on host machine
	},
	"overrideCommand": true,
	"postCreateCommand": [
		"bash",
		"-c",
		"echo 'export PORT=3001' >> ~/.bashrc"
	], // to prevent conflicts on 3000 used on host machine
	"postAttachCommand": [
		"bash",
		"-c",
		"source ~/.bashrc && rm -rf dist && npm run start:dev"
	], // Run the server on devcontainer load on port 3001
	"portsAttributes": { // Name ports to not have to remember the numbers
		"3001": {
			"label": "API"
		},
		"3030": {
			"label": "Prisma Studio"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [ // list of vscode extensions to install in the container
				"esbenp.prettier-vscode", // Prettier extension for code formatting
				"prisma.prisma", // Prisma extension for working with Prisma schema files
				"ms-azuretools.vscode-docker", // Docker extension for managing Docker containers and images
				"christian-kohler.path-intellisense", // Path Intellisense extension for autocompleting file paths
				"humao.rest-client" // For testing REST APIs directly from the editor
			],
			"settings": { // vscode settings to apply in the container
				"terminal.integrated.defaultProfile.linux": "bash",
				"editor.formatOnSave": true,
				"extensions.verifySignature": false
			}
		}
	},
	"remoteUser": "root", // user to use in the container
	"shutdownAction": "stopContainer" // action to take when shutting down the container (none, stopContainer, or removeContainer)
}